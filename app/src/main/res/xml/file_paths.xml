<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider path configuration (SPECIFICATION.md §6, §7): exactly the four
  content categories are exposed as content URIs — and only ever handed out
  per file with temporary read permission. Temp/ and the .hash sidecars and
  ZIP markers are internal metadata and never shared (§11: 24).
-->
<paths>
    <files-path
        name="books"
        path="Books/" />
    <files-path
        name="music"
        path="Music/" />
    <files-path
        name="documents"
        path="Documents/" />
    <files-path
        name="other"
        path="Other/" />
</paths>
